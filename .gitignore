# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Every .env variant, not just the exact name. Editors leave working copies
# behind -- nano writes .env.save on an interrupted edit -- and one of those
# carrying a filled-in OTA_SECRET_KEY would put the deploy key in the repo.
# .env.production is deliberate and stays tracked: public CDN urls for the
# notebook runtimes, no secrets.
.env*
!.env.production

# PR drafts and working notes, not project files.
Claude outputs/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ground truth student photos - local only
public/ground-truth/*
!public/ground-truth/.gitkeep


.yarn/install-state.gz
yarn.lock
.yarn.env 
.yarn
# Notebook kernel runtimes, fetched at build time by scripts/fetch-runtimes.mjs.
# ~490MB of Pyodide and clang WebAssembly; downloaded, not committed.
public/pyodide/
public/clang/
