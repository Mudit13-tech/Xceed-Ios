# Native (iOS/Android) API origin. Unset -> production (https://xceed.nitj.ac.in).
# Simulator: localhost reaches this Mac. Physical device: use the Mac's LAN IP
# from `ipconfig getifaddr en0`, with both on the same Wi-Fi.
VITE_NATIVE_API_ORIGIN=https://xceed.nitj.ac.in

# OTA publishing. The key is not a secret to obtain -- pick any string and set
# the identical value in the backend server's own .env, or uploads 401.
OTA_SERVER_URL=http://localhost:8010
OTA_SECRET_KEY=

# Keep this dev build's own JS. Without it the OTA updater replaces the
# bundle with production's within seconds of launch, undoing local changes.
VITE_DISABLE_OTA=1
VITE_NATIVE_API_ORIGIN=http://localhost:8010

