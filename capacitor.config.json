{
  "appId": "in.ac.nitj.xceed.learning.app",
  "appName": "XCEED",
  "webDir": "dist",
  "server": {
    "hostname": "xceed.learning.app",
    "cleartext": true,
    "androidScheme": "http",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/camera",
      "@capacitor/file-viewer",
      "@capacitor/filesystem",
      "@capacitor/preferences",
      "@capacitor/push-notifications",
      "@capacitor/share",
      "@capawesome/capacitor-file-picker",
      "@capgo/capacitor-downloader",
      "@capgo/capacitor-updater",
      "capacitor-native-biometric",
      "capacitor-secure-storage-plugin"
    ]
  }
}
